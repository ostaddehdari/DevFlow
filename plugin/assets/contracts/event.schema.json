{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/event.schema.json",
  "title": "DevFlow Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "project_id",
    "severity",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
    },
    "project_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "SUCCESS",
        "WARNING",
        "CRITICAL"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "server_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
