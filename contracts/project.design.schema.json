{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/project.design.schema.json",
  "title": "DevFlow Project Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "objectives",
    "scope",
    "architecture",
    "stages",
    "execution",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PLANNED",
            "ACTIVE",
            "PAUSED",
            "BLOCKED",
            "COMPLETED",
            "ARCHIVED"
          ]
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "future"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "title",
          "status",
          "goal",
          "depends_on",
          "works",
          "completion_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STAGE-[A-Za-z0-9._-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "VERIFYING",
              "FAILED",
              "COMPLETED"
            ]
          },
          "goal": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "works": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "number",
                "title",
                "type",
                "status",
                "description",
                "acceptance_criteria",
                "tests",
                "git",
                "deployment",
                "failure_policy"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^WORK-[A-Za-z0-9._-]+$"
                },
                "number": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "development",
                    "infrastructure",
                    "migration",
                    "testing",
                    "deployment",
                    "documentation",
                    "security",
                    "research",
                    "operations"
                  ]
                },
                "status": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "TESTING",
                    "COMMITTING",
                    "DEPLOYING",
                    "VERIFYING",
                    "FAILED",
                    "COMPLETED"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "object"
                    ]
                  }
                },
                "files_expected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "required",
                    "commands",
                    "health_checks"
                  ],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "health_checks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "git": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "commit_required",
                    "push_required"
                  ],
                  "properties": {
                    "commit_required": {
                      "type": "boolean"
                    },
                    "push_required": {
                      "type": "boolean"
                    },
                    "commit_strategy": {
                      "enum": [
                        "after_work",
                        "after_milestone",
                        "manual"
                      ]
                    }
                  }
                },
                "deployment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "required"
                  ],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    },
                    "environment": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "failure_policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "auto_diagnose",
                    "auto_fix",
                    "max_automatic_attempts",
                    "rollback_on_critical_failure"
                  ],
                  "properties": {
                    "auto_diagnose": {
                      "type": "boolean"
                    },
                    "auto_fix": {
                      "type": "boolean"
                    },
                    "max_automatic_attempts": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50
                    },
                    "rollback_on_critical_failure": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "completion_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "all_works_required",
              "tests_must_pass",
              "deployment_must_pass"
            ],
            "properties": {
              "all_works_required": {
                "type": "boolean"
              },
              "tests_must_pass": {
                "type": "boolean"
              },
              "deployment_must_pass": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "on_failure",
        "continue_automatically",
        "stop_conditions"
      ],
      "properties": {
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "on_failure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "continue_automatically": {
          "type": "boolean"
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_status",
        "ready_for_execution",
        "blocking_questions"
      ],
      "properties": {
        "design_status": {
          "enum": [
            "READY",
            "READY_WITH_AUTOFIXES",
            "BLOCKED"
          ]
        },
        "ready_for_execution": {
          "type": "boolean"
        },
        "proposal_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "works_with_acceptance_criteria_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "blocking_questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
