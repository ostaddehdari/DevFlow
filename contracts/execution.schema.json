{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/execution.schema.json",
  "title": "DevFlow Execution Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "status",
    "owner",
    "started_at",
    "heartbeat",
    "expires_after_seconds"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "INTERRUPTED",
        "RECOVERING",
        "WAITING_HUMAN",
        "DONE"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "expires_after_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "job_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "resume_required": {
      "type": "boolean"
    },
    "wait_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
