{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://devflow.local/schemas/network.schema.json",
  "title":"DevFlow OAuth resource server configuration",
  "type":"object","additionalProperties":false,
  "required":["schema_version","issuer","resource","jwks_path","principals"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "issuer":{"type":"string","format":"uri","pattern":"^https://"},
    "resource":{"type":"string","format":"uri","pattern":"^https://"},
    "jwks_path":{"type":"string","minLength":1},
    "principals":{"type":"array","minItems":1,"maxItems":1000,"items":{
      "type":"object","additionalProperties":false,
      "required":["subject","client_id","role","projects"],
      "properties":{
        "subject":{"type":"string","minLength":1,"maxLength":256},
        "client_id":{"type":"string","minLength":1,"maxLength":256},
        "role":{"enum":["viewer","operator"]},
        "projects":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,
          "items":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"}}
      }
    }}
  }
}
